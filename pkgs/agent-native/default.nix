# The CLI behind the visual-plan and visual-recap skills, pinned so agents never
# fetch and run the latest release through npx.
{
  lib,
  buildNpmPackage,
  fetchurl,
  jq,
  makeWrapper,
  nodejs,
}:

buildNpmPackage rec {
  pname = "agent-native";
  version = "0.235.0";

  # The published tarball ships a prebuilt dist/ and no lockfile, so
  # ./package-lock.json is generated by bin/update-agent-native.
  src = fetchurl {
    url = "https://registry.npmjs.org/@agent-native/core/-/core-${version}.tgz";
    hash = "sha256-FPuJoYiFlg5RFO/8y+jnGTboACdhAvaoVXXdNNJbHm0=";
  };

  # The optional peers belong to the app framework in the same package, not to
  # the CLI. Skipping peers also skips the required ones, so those become
  # dependencies. bin/update-agent-native applies the same edit.
  postPatch = ''
    ${lib.getExe jq} -f ${./package-json.jq} package.json > package.json.tmp
    mv package.json.tmp package.json
    cp ${./package-lock.json} package-lock.json
  '';

  npmDepsHash = "sha256-W5WmfbSCK6UoZiQek4VE5yw1YQsf06e0IqK9bo/awfM=";
  npmFlags = [ "--legacy-peer-deps" ];

  dontNpmBuild = true;

  nativeBuildInputs = [ makeWrapper ];

  postInstall = ''
    wrapProgram $out/bin/agent-native \
      --set AGENT_NATIVE_TELEMETRY_DISABLED 1
  '';

  meta = {
    description = "Agent-Native CLI, used here for local visual plans";
    homepage = "https://github.com/BuilderIO/agent-native";
    license = lib.licenses.mit;
    mainProgram = "agent-native";
    inherit (nodejs.meta) platforms;
  };
}
