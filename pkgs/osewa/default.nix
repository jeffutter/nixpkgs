{
  lib,
  stdenvNoCC,
  fetchurl,
  gzip,
  runCommand,
  python3,
}:

let
  version = "0.1.2";

  # Upstream ships gzipped static binaries (https://osewa.dev/install.sh).
  # `bin/update-osewa` refreshes the version and these hashes.
  sources = {
    "aarch64-darwin" = {
      url = "https://github.com/rjyo/osewa/releases/download/v${version}/osewa-darwin-arm64.gz";
      hash = "sha256-ixepHsXrYAyFxH6mcP96svHXLbxrkSGVtKLS6zIkIJM=";
    };
    "x86_64-darwin" = {
      url = "https://github.com/rjyo/osewa/releases/download/v${version}/osewa-darwin-amd64.gz";
      hash = "sha256-yvENHsWsUzAbdwNvhEdU+XvJwXNVRol4iL8ZuEReZWQ=";
    };
    "aarch64-linux" = {
      url = "https://github.com/rjyo/osewa/releases/download/v${version}/osewa-linux-arm64.gz";
      hash = "sha256-Hi5QO1n4O8ARFlTZG4KR3RRtS96pBPqBAYQmht81YLw=";
    };
    "x86_64-linux" = {
      url = "https://github.com/rjyo/osewa/releases/download/v${version}/osewa-linux-amd64.gz";
      hash = "sha256-kNoTOkcAW7nri/ikGyb3xXMi9rkp3oGbldGks5kluac=";
    };
  };
in
stdenvNoCC.mkDerivation (finalAttrs: {
  pname = "osewa";
  inherit version;

  src = fetchurl (
    sources.${stdenvNoCC.hostPlatform.system}
      or (throw "osewa: unsupported system ${stdenvNoCC.hostPlatform.system}")
  );

  dontUnpack = true;
  nativeBuildInputs = [ gzip ];

  installPhase = ''
    runHook preInstall
    mkdir -p "$out/bin"
    gzip -dc "$src" > "$out/bin/osewa"
    chmod +x "$out/bin/osewa"
    runHook postInstall
  '';

  # The launchd agent as JSON, generated by `osewa service install` itself. A stub launchctl
  # keeps it from loading anything. The binary path becomes "@osewa@" and the log paths are
  # dropped, because both hold build-specific values; the caller supplies them.
  passthru.launchdAgent =
    runCommand "osewa-launchd-agent.json"
      {
        nativeBuildInputs = [ python3 ];
      }
      ''
        export HOME="$PWD/home"
        mkdir -p "$HOME" stub
        printf '#!/bin/sh\nexit 0\n' > stub/launchctl
        chmod +x stub/launchctl
        PATH="$PWD/stub:$PATH" ${finalAttrs.finalPackage}/bin/osewa service install > /dev/null
        python3 - "$HOME/Library/LaunchAgents/dev.osewa.server.plist" > "$out" <<'EOF'
        import json, plistlib, sys
        agent = plistlib.load(open(sys.argv[1], "rb"))
        assert agent["ProgramArguments"][0].endswith("/bin/osewa")
        agent["ProgramArguments"][0] = "@osewa@"
        del agent["StandardOutPath"], agent["StandardErrorPath"]
        print(json.dumps(agent, sort_keys=True))
        EOF
      '';

  meta = {
    description = "Osewa";
    homepage = "https://osewa.dev";
    mainProgram = "osewa";
    platforms = lib.attrNames sources;
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
  };
})
