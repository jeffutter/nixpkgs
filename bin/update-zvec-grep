#!/usr/bin/env bash
set -euo pipefail

PKG="${HOME}/.config/home-manager/pkgs/zvec-grep/default.nix"
NAME="@zvec/zvec-grep"

# Nix system -> npm platform package suffix. The suffix anchors each hash
# substitution in default.nix, so keep it in sync with the sources there.
systems=("aarch64-darwin" "x86_64-linux" "aarch64-linux")
targets=("darwin-arm64" "linux-x64-gnu" "linux-arm64-gnu")

# --force rewrites the hashes even when the pinned version is already
# current, to repair a package whose hashes are wrong rather than stale.
FORCE=0
for ARG in "$@"; do
  case "$ARG" in
    --force) FORCE=1 ;;
    *)
      echo "usage: ${0##*/} [--force]" >&2
      exit 1
      ;;
  esac
done

echo "Fetching latest ${NAME} version..."
LATEST=$(curl -sf "https://registry.npmjs.org/${NAME}/latest" | jq -r '.version')

if [[ -z "$LATEST" || "$LATEST" == "null" ]]; then
  echo "error: failed to fetch latest ${NAME} version from npm" >&2
  exit 1
fi

CURRENT=$(grep 'version = ' "$PKG" | head -1 | sed 's/.*"\(.*\)".*/\1/')

echo "Current: $CURRENT  Latest: $LATEST"

if [[ "$LATEST" == "$CURRENT" && "$FORCE" != "1" ]]; then
  echo "Already at latest version, nothing to do."
  exit 0
fi

WORK="$(mktemp -d "${TMPDIR:-/tmp}/zvec-grep.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

# Compute every hash before touching default.nix so a failed download leaves
# the package unchanged. Hashes are never printed: DLP tooling flags SRI/sha
# strings in command output.
declare -A HASHES
for i in "${!systems[@]}"; do
  sys="${systems[$i]}"
  target="${targets[$i]}"
  echo "Fetching ${sys} (${target})..."
  curl -sfL "https://registry.npmjs.org/@zvec/zvec-grep-${target}/-/zvec-grep-${target}-${LATEST}.tgz" \
    -o "${WORK}/${target}.tgz"
  HASHES["$target"]="$(nix hash file --sri --type sha256 "${WORK}/${target}.tgz")"
done

echo "Updating pkgs/zvec-grep/default.nix..."
perl -pi -e "s|version = \"[^\"]+\"|version = \"${LATEST}\"|" "$PKG"
for target in "${targets[@]}"; do
  TARGET="$target" HASH="${HASHES[$target]}" perl -0777 -pi -e '
    my $t = quotemeta($ENV{TARGET});
    s/(npmUrl "${t}";\s*\n\s*hash = ")[^"]*(")/$1$ENV{HASH}$2/;
  ' "$PKG"
done

# A perl s||| that matches nothing exits 0, so confirm each value landed.
for target in "${targets[@]}"; do
  if ! grep -qF "hash = \"${HASHES[$target]}\"" "$PKG"; then
    echo "error: failed to write ${target} hash into ${PKG}" >&2
    exit 1
  fi
done
grep -qF "version = \"${LATEST}\"" "$PKG" || {
  echo "error: failed to write version into ${PKG}" >&2
  exit 1
}

echo "Updated zvec-grep: $CURRENT -> $LATEST"
