#!/usr/bin/env bash
set -euo pipefail

PKG="${HOME}/.config/home-manager/pkgs/osewa/default.nix"
REPO="rjyo/osewa"

# Nix system -> release asset. The asset name anchors each hash substitution.
systems=("aarch64-darwin" "x86_64-darwin" "aarch64-linux" "x86_64-linux")
assets=("osewa-darwin-arm64.gz" "osewa-darwin-amd64.gz" "osewa-linux-arm64.gz" "osewa-linux-amd64.gz")

echo "Fetching latest osewa release..."
LATEST=$(curl -sfL "https://github.com/${REPO}/releases/latest/download/build.json" |
  sed -n 's/.*"osewa":"\([0-9][0-9.]*\)".*/\1/p')

if [[ -z "$LATEST" || "$LATEST" == "null" ]]; then
  echo "error: failed to fetch latest release from GitHub" >&2
  exit 1
fi

CURRENT=$(grep 'version = ' "$PKG" | head -1 | sed 's/.*"\(.*\)".*/\1/')

echo "Current: $CURRENT  Latest: $LATEST"

if [[ "$LATEST" == "$CURRENT" ]]; then
  echo "Already at latest version, nothing to do."
  exit 0
fi

WORK="$(mktemp -d "${TMPDIR:-/tmp}/osewa.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
BASE="https://github.com/${REPO}/releases/download/v${LATEST}"

perl -pi -e "s|version = \"[^\"]+\"|version = \"${LATEST}\"|" "$PKG"

# Hashes are never printed: DLP tooling flags SRI/sha strings in command output.
for i in "${!systems[@]}"; do
  sys="${systems[$i]}"
  asset="${assets[$i]}"
  echo "Fetching ${sys} (${asset})..."
  curl -sfL "${BASE}/${asset}" -o "${WORK}/${asset}"
  SRI="$(nix hash file --sri --type sha256 "${WORK}/${asset}")"
  ASSET="$asset" HASH="$SRI" perl -0777 -pi -e '
    my $asset = quotemeta($ENV{ASSET});
    s/(${asset}";\s*\n\s*hash = ")[^"]*(")/$1$ENV{HASH}$2/;
  ' "$PKG"
done

echo "Updated osewa: $CURRENT -> $LATEST"
